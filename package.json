{
  "name": "tsi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend generate",
    "typecheck": "pnpm --dir frontend exec nuxi typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:types": "supabase gen types typescript --local > frontend/types/database.types.ts",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "test:db": "docker exec -i supabase_db_tsi psql -U postgres -v ON_ERROR_STOP=1 -q < supabase/tests/security_test.sql",
    "test:parser": "docker compose exec -T parser sh -c \"pip install -q -r requirements-dev.txt && python -m pytest -q\"",
    "import": "python3 scripts/bulk_import.py"
  }
}
