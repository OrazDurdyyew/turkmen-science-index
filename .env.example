SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# JWT version of service key for Python Supabase SDK (parser service)
SUPABASE_SERVICE_KEY_JWT=your-service-role-jwt

# --- Parser service (docker compose) ---
# Supabase URL as seen from inside the parser container (local default: host.docker.internal:54321)
# PARSER_SUPABASE_URL=https://your-project.supabase.co
# Frontend origins allowed to call the parser, comma-separated (default: *)
# CORS_ORIGINS=https://tsi.example.tm

# --- Production frontend (docker compose --profile prod) ---
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_PARSER_URL=https://parser.tsi.example.tm
# FRONTEND_PORT=8080
# RESTART_POLICY=unless-stopped

# --- Bulk import (scripts/bulk_import.py): an admin account ---
# TSI_EMAIL=admin@example.tm
# TSI_PASSWORD=...

# Local test user (created via admin API, local Supabase only)
TEST_USER_EMAIL=test@tsi.localhost
TEST_USER_PASSWORD=change-me
TEST_USER2_EMAIL=user2@tsi.localhost
TEST_USER2_PASSWORD=change-me-too
